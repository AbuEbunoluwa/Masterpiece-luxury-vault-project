# Copy this to .env for local development. Never commit the real .env file.

PORT=4000

# Local Postgres (via docker-compose) — swap for RDS values in production,
# injected as Kubernetes Secrets rather than a .env file.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=masterpiece_vault
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Generate a real random secret for this — never reuse across environments.
JWT_SECRET=replace-this-with-a-long-random-string

# Stripe test mode keys — from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# From `stripe listen --print-secret` when testing webhooks locally,
# or from the Stripe Dashboard once a real webhook endpoint is configured.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
